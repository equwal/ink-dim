<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Shell access through Shizuku. The light node belongs to the system, so
        the app cannot write it by itself. There is no other permission, and no
        INTERNET permission.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.App">

        <!--
            The launcher icon. It draws nothing: it does the toggle and goes
            away. A long press on the icon offers the settings screen.
        -->
        <activity
            android:name=".ToggleActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:taskAffinity="dev.equwal.inkdim.toggle"
            android:theme="@style/Theme.Invisible">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- For a key remapper, or any other app that asks for the toggle. -->
            <intent-filter>
                <action android:name="dev.equwal.inkdim.TOGGLE" />
                <action android:name="dev.equwal.inkdim.ON" />
                <action android:name="dev.equwal.inkdim.OFF" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/settings_label" />

        <!-- A tile in the quick settings panel. It does the same toggle. -->
        <service
            android:name=".DimTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
